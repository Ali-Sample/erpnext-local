# The one place versions are set. compose.yaml reads this file; nothing else may pin a version.
# Matches RHOS CI (rh-erpnext-custom .github/workflows/ci.yml) as of 2026-11-17.
# Images are pinned by digest (amd64), so a re-pushed tag can't change what runs.

# frappe/erpnext:v16.37.0 (ERPNext v16.37.0; bundled Frappe version checked after first start, RHOS expects v16.36.0)
ERPNEXT_IMAGE=frappe/erpnext:v16.37.0@sha256:14217867ba080ed8c64f21d1c0d4ab281c3abb5d96c69d59e0117bc671ee00f2
MARIADB_IMAGE=mariadb:11.8@sha256:75b300c790eec33cd4386d80fc1a938e27604ba70f3eeda25e52874be2aae424
REDIS_IMAGE=redis:7.4@sha256:a6dd428750118c2c2c67d3f555faef0aa15a2b71198b40e1cb3b9229b1cf3094

SITE_NAME=sandbox.localhost
# 8081, not 8080: the RHOS eval stack on this machine already uses 8080.
HTTP_PORT=8081
